# ===== rclona 配置示例 =====
# 复制为 .env 后按需修改：cp .env.example .env

# 面板对外端口
PANEL_PORT=8080

# 面板登录账号（密码留空时，首次打开网页会引导你设置账号密码）
PANEL_USER=admin
PANEL_PASSWORD=

# 时区（影响定时备份与每日网盘自检的时间）
TZ=Asia/Shanghai

# Telegram 通知代理（可选）：直连 api.telegram.org 不通时填，通知经此 HTTP 代理走
# 只影响 Telegram 通知，网盘备份（rclone）不走它。留空 = 直连
# TELEGRAM_PROXY=http://127.0.0.1:7890
